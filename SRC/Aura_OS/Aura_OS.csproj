<Project InitialTargets="GetVersion" Sdk="Cosmos.Sdk">

	<PropertyGroup>
		<CosmosKernelClass>Aura_Boot.Kernel</CosmosKernelClass>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Aura_OS</RootNamespace>
		<!-- Append: the Cosmos architecture picker already put ARCH_X64/ARCH_ARM64 in here -->
		<DefineConstants>$(DefineConstants);TRACE;NOASYNC</DefineConstants>
		<!-- The gen2 codebase predates nullable annotations -->
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
	</PropertyGroup>

	<PropertyGroup>
		<Year>$([System.DateTime]::Now.ToString("yyyy"))</Year>
		<Month>$([System.DateTime]::Now.ToString("MM"))</Month>
		<Date>$([System.DateTime]::Now.ToString("dd"))</Date>
		<Time>$([System.DateTime]::Now.ToString("HHmm"))</Time>
		<SomeThing>
			<![CDATA[
        namespace Aura_OS
{
    public class VersionInfo
    {
        public static string revision = "$(Date)$(Month)$(Year)$(Time)"%3b
    }
}
       ]]>
		</SomeThing>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\auralogo_white.bmp" LogicalName="Aura_OS.Resources.auralogo_white.bmp" />
		<EmbeddedResource Include="Resources\error.bmp" LogicalName="Aura_OS.Resources.error.bmp" />
		<EmbeddedResource Include="Resources\Tetris.gb" LogicalName="Aura_OS.Resources.Tetris.gb" />
		<EmbeddedResource Include="Resources\HelloWorld.gb" LogicalName="Aura_OS.Resources.HelloWorld.gb" />
		<EmbeddedResource Include="Resources\wallpaper-1.bmp" LogicalName="Aura_OS.Resources.wallpaper-1.bmp" />
		<EmbeddedResource Include="Resources\wallpaper-2.bmp" LogicalName="Aura_OS.Resources.wallpaper-2.bmp" />
		<!-- gen2 shipped these on the ISO (isoFiles); gen3 ISOs carry only the kernel ELF,
		     so all UI assets are embedded and read via Cosmos.Kernel.Core.Runtime.ResourceManager.
		     Logical name = "Aura_OS.UI." + relative path with '/' separators (see Files.GetUiResource). -->
		<EmbeddedResource Include="Resources\UI\**\*.bmp;Resources\UI\**\*.psf;Resources\UI\**\*.xml">
			<LogicalName>Aura_OS.UI.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<!-- Core gen3 kernel packages (resolved from the nativeaot-patcher local feed, see NuGet.Config) -->
	<ItemGroup>
		<PackageReference Include="Cosmos.Kernel" Version="3.0.63.20260714" />
		<PackageReference Include="Cosmos.Kernel.System" Version="3.0.63.20260714" />
	</ItemGroup>

	<!-- Pure-managed packages kept from gen2 (no native/IL2CPU dependency).
	     GEN3-TODO: unverified under the gen3 NativeAOT runtime, smoke-test at runtime. -->
	<ItemGroup>
		<PackageReference Include="acryptohashnet" Version="2.0.0" />
		<PackageReference Include="jzero" Version="0.4.5" />
	</ItemGroup>

	<Target Name="GetVersion">
		<WriteLinesToFile File="Properties\VersionInfo.cs" Lines="$(SomeThing)" Overwrite="true" />
	</Target>

</Project>
