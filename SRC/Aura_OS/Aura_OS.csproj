<Project Sdk="Cosmos.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aura_OS</RootNamespace>
    <!-- Default would be Aura_OS.Kernel (Aura's static state class, not a Cosmos.Kernel.System.Kernel). -->
    <CosmosKernelClass>Aura_Boot.Kernel</CosmosKernelClass>
    <ImplicitUsings>disable</ImplicitUsings>   <!-- Aura relies on explicit usings + Aura_OS.System shadowing -->
    <Nullable>disable</Nullable>               <!-- gen2 code; no '?' annotations on reference types (CS8632) -->
    <InvariantTimezone>true</InvariantTimezone><!-- TimeZoneInfo.Local never probes tzfiles -->
    <CosmosDefaultFont>Aura_OS/UI/Fonts/zap-ext-light16.psf</CosmosDefaultFont> <!-- boot KernelConsole in Aura's font -->
    <!-- No DefineConstants (UniLua was the only user). If ever needed: $(DefineConstants);X  (never replace: drops ARCH_X64). -->
    <!-- Feature switches stay at their defaults (all true). AllowUnsafeBlocks already true in Sdk.props. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cosmos.Kernel" Version="$(AuraCosmosVersion)" />
    <PackageReference Include="Cosmos.Kernel.System" Version="$(AuraCosmosVersion)" />
    <PackageReference Include="Cosmos.Network.Ftp" Version="$(AuraFtpVersion)" />
    <PackageReference Include="Cosmos.Network.Http" Version="$(AuraHttpVersion)" />
    <PackageReference Include="Cosmos.Executable.Lua" Version="$(AuraLuaVersion)" />
    <PackageReference Include="acryptohashnet" Version="2.0.0" />                 <!-- cosmos.crypto Lua lib only -->
    <PackageReference Include="jzero" Version="0.4.5" />                           <!-- JsonReader only -->
    <PackageReference Include="Zlib.Portable" Version="1.11.0" NoWarn="NU1701" />  <!-- managed DEFLATE for ZipStorer/.pkg -->
  </ItemGroup>

  <!-- Every file under Resources/ is embedded as "Aura_OS/<path relative to Resources, '/'-separated>".
       ASCII names only; read through Files.Get(relPath). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*">
      <LogicalName>Aura_OS/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Built-in programs: every SRC/Packages/<Name>/ folder (package.xml, Lua code, layout...) is zipped into
       <Name>.pkg, the same file a download installs, and embedded as "Aura_OS/Packages/<Name>.pkg".
       SRC/Packages/README.md describes the format. -->
  <ItemGroup>
    <!-- Published to the online repository only: pkg /add downloads them. -->
    <AuraDownloadOnlyPackage Include="Snake" />

    <AuraPackage Include="..\Packages\*\package.xml" Exclude="@(AuraDownloadOnlyPackage->'..\Packages\%(Identity)\package.xml')">
      <PackageName>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(FullPath)'))))</PackageName>
    </AuraPackage>
    <AuraPackageFile Include="..\Packages\*\**\*" Exclude="@(AuraDownloadOnlyPackage->'..\Packages\%(Identity)\**')" />
    <EmbeddedResource Include="@(AuraPackage->'$(IntermediateOutputPath)Packages\%(PackageName).pkg')">
      <LogicalName>Aura_OS/Packages/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="AuraBuildPackages" BeforeTargets="CoreCompile" Inputs="@(AuraPackageFile)"
          Outputs="@(AuraPackage->'$(IntermediateOutputPath)Packages\%(PackageName).pkg')">
    <MakeDir Directories="$(IntermediateOutputPath)Packages" />
    <ZipDirectory SourceDirectory="%(AuraPackage.RootDir)%(AuraPackage.Directory)"
                  DestinationFile="$(IntermediateOutputPath)Packages\%(AuraPackage.PackageName).pkg" Overwrite="true" />
    <ItemGroup>
      <FileWrites Include="@(AuraPackage->'$(IntermediateOutputPath)Packages\%(PackageName).pkg')" />
    </ItemGroup>
  </Target>

  <!-- AuraVersion: bumping it on main makes CI publish a release (notes from its CHANGELOG.md section).
       gen2 revision format ddMMyyyyHHmm; Debug pins HHmm=0000 so build caches survive a dev session;
       CI passes -p:AuraRevision so the release tag and the in-OS revision match. -->
  <PropertyGroup>
    <AuraVersion>0.8.0</AuraVersion>
    <AuraRevision Condition="'$(AuraRevision)' == '' and '$(Configuration)' == 'Release'">$([System.DateTime]::Now.ToString("ddMMyyyyHHmm"))</AuraRevision>
    <AuraRevision Condition="'$(AuraRevision)' == ''">$([System.DateTime]::Now.ToString("ddMMyyyy"))0000</AuraRevision>
  </PropertyGroup>

  <!-- Adapted from GenerateKernelVersionCs in Cosmos.Kernel.System.csproj (replaces gen2's GetVersion target
       and the tracked Properties/VersionInfo.cs). -->
  <Target Name="AuraGenerateVersionInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_AuraVersionInfoFile>$(IntermediateOutputPath)VersionInfo.g.cs</_AuraVersionInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <_AuraVersionInfoLine Include="// &lt;auto-generated/&gt;" />
      <_AuraVersionInfoLine Include="namespace Aura_OS" />
      <_AuraVersionInfoLine Include="{" />
      <_AuraVersionInfoLine Include="    public class VersionInfo" />
      <_AuraVersionInfoLine Include="    {" />
      <_AuraVersionInfoLine Include="        public static string version = &quot;$(AuraVersion)&quot;%3B" />
      <_AuraVersionInfoLine Include="        public static string revision = &quot;$(AuraRevision)&quot;%3B" />
      <_AuraVersionInfoLine Include="    }" />
      <_AuraVersionInfoLine Include="}" />
    </ItemGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(_AuraVersionInfoFile)" Lines="@(_AuraVersionInfoLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_AuraVersionInfoFile)" />
      <FileWrites Include="$(_AuraVersionInfoFile)" />
    </ItemGroup>
  </Target>

</Project>
