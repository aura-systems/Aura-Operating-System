<?xml version="1.0" encoding="utf-8"?>
<!-- Memory information app window. MemoryInfoApp.cs refreshes the values. -->
<Window title="MemoryInfo" width="400" height="300" padding="5,6">
  <Grid columns="auto,*" columnSpacing="16" rowSpacing="2">
    <Row>
      <Label text="Memory pool:" />
      <Label id="memoryPool" />
    </Row>
    <Row>
      <Label text="Used memory:" />
      <Label id="usedMemory" />
    </Row>
    <Row>
      <Label text="Free memory:" />
      <Label id="freeMemory" />
    </Row>
    <Row>
      <Label text="Total Page Count:" />
      <Label id="totalPages" />
    </Row>
    <Row>
      <Label text="Free Page Count:" />
      <Label id="freePages" />
    </Row>
    <Row>
      <Label text="Live heap:" />
      <Label id="liveHeap" />
    </Row>
    <Row>
      <Label text="Heap size (last GC):" />
      <Label id="gcHeapSize" />
    </Row>
    <Row>
      <Label text="Committed (last GC):" />
      <Label id="gcCommitted" />
    </Row>
    <Row>
      <Label text="Fragmented (last GC):" />
      <Label id="gcFragmented" />
    </Row>
    <Row>
      <Label text="Pinned objects (last GC):" />
      <Label id="gcPinnedObjects" />
    </Row>
    <Row>
      <Label text="Collections:" />
      <Label id="collections" />
    </Row>
    <Row>
      <Label text="Objects freed:" />
      <Label id="objectsFreed" />
    </Row>
    <Row>
      <Label text="GC time:" />
      <Label id="gcTime" />
    </Row>
    <Row>
      <Label text="Free Count:" />
      <Label id="freeCount" />
    </Row>
  </Grid>
</Window>
