<?xml version="1.0" encoding="utf-8"?>
<!-- File Explorer app window: the folder's path, the actions, the places and the folder's entries.
     main.lua fills them, and does the actions. -->
<Window title="File Explorer" width="620" height="420" icon="16-explorer.bmp" padding="6" spacing="6">
  <Stack orientation="horizontal" spacing="4" height="23">
    <Button icon="16-back.bmp" width="23" onClick="back" />
    <Button icon="16-up.bmp" width="23" onClick="up" />
    <TextBox id="path" width="*" onEnter="go" />
    <Button icon="16-refresh.bmp" width="23" onClick="refresh" />
    <Button icon="16-terminal.bmp" width="23" onClick="terminal" />
  </Stack>

  <Stack orientation="horizontal" spacing="4" height="23">
    <Button icon="16-new-folder.bmp" text="New folder" onClick="newFolder" />
    <Button icon="16-new-file.bmp" text="New file" onClick="newFile" />
    <Button icon="16-copy.bmp" text="Copy" onClick="copy" />
    <Button icon="16-cut.bmp" text="Cut" onClick="cut" />
    <Button icon="16-paste.bmp" text="Paste" onClick="paste" />
    <Button text="Rename" onClick="rename" />
    <Button icon="16-delete.bmp" text="Delete" onClick="delete" />
  </Stack>

  <!-- The name of a new folder or file, or a new name: the buttons that need one show it. -->
  <Stack id="nameBar" orientation="horizontal" spacing="4" height="23" visible="false">
    <Label id="nameLabel" text="Name:" />
    <TextBox id="name" width="*" onEnter="nameOk" />
    <Button text="OK" width="70" onClick="nameOk" />
    <Button text="Cancel" width="70" onClick="nameCancel" />
  </Stack>

  <Stack orientation="horizontal" spacing="6" height="*">
    <ListBox id="places" width="140" height="*" onChange="place" />
    <ListBox id="files" width="*" height="*" onChange="select" onActivate="open" />
  </Stack>

  <Label id="status" />

  <Dialog id="confirm" title="Delete" visible="false">
    <Button text="Delete" onClick="confirmDelete" />
    <Button text="Cancel" onClick="closeConfirm" />
  </Dialog>

  <Dialog id="error" title="Error" state="error" visible="false">
    <Button text="OK" onClick="closeError" />
  </Dialog>
</Window>
