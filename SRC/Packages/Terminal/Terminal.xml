<?xml version="1.0" encoding="utf-8"?>
<!-- Terminal app window: a console filling the window. main.lua edits the command line and runs it in a shell; onPaste is the right click menu's Paste. -->
<Window title="Terminal" width="700" height="600" icon="terminal" padding="1,3,1,1">
  <Console id="console" width="*" height="*" cursor="true" scrollBar="true" onPaste="paste" />
</Window>
