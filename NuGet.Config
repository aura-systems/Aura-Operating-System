<?xml version="1.0" encoding="utf-8"?>
<!-- Assumes the sibling checkout ~/Documents/Github/{Aura-Operating-System,Cosmos} (local feed built by Cosmos's `make setup`). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="cosmos-local" value="../Cosmos/artifacts/package/release" />
    <!-- TEMPORARY: Cosmos.Network.Http 2.1.0 packed from the sibling checkout (CI: HTTP_REF) until it is on nuget.org. -->
    <add key="http-local" value="../Cosmos.Network.Http/artifacts" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="http-local">
      <package pattern="Cosmos.Network.Http" />
    </packageSource>
    <packageSource key="cosmos-local">
      <package pattern="Cosmos.*" />
      <package pattern="_Cosmos.*" />          <!-- Cosmos.Build.Analyzer.Patcher depends on _Cosmos.* -->
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="Cosmos.Network.*" />   <!-- longest pattern wins: FTP from nuget.org -->
      <package pattern="Cosmos.Executable.*" /><!-- Lua from nuget.org -->
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
